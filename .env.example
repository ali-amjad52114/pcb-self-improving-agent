# Runtime
AGENT_MODE=fake
TARGET_METRIC=macro_f1
TARGET_VALUE=0.84
EXPERIMENT_BUDGET=4
MEMORY_TOP_K=5
LOG_LEVEL=INFO

# Person 1: MongoDB Atlas memory + LangGraph checkpointing
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=persistent_context
MONGODB_DB_NAME=persistent_context
MEMORY_MODULE=pcb_memory.memory
CHECKPOINTER_BACKEND=memory

# Voyage AI embeddings for Atlas Vector Search
VOYAGE_API_KEY=
VOYAGEAI_API_KEY=

# Person 2 teammate modules
ML_MODULE=pcb_agent.integrations.pcb_ml
REASONING_MODULE=fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-20b
FIREWORKS_TIMEOUT_SECONDS=30
PCB_DATASET_MANIFEST=data/pcb_splits.json
PCB_MODEL_DIR=data/models

# Person 3 OpenRouter judge
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_RETRIES=2

# LangSmith observability (native LangGraph tracing)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pcb-self-improving-agent

# Authenticated dashboard API (use a long random value)
PCB_API_TOKEN=
PCB_API_MAX_WORKERS=1
PCB_API_CORS_ORIGINS=
