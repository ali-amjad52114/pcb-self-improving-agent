# Atlas Hackathon Sandbox URI (from the email MongoDB sent you)
# Your build must live in this sandbox to be eligible for finalists.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=persistent_context

# Voyage AI — embeddings for Atlas Vector Search
VOYAGE_API_KEY=
VOYAGEAI_API_KEY=

# OpenRouter — $10 credits: https://app.notion.com/p/openrouter/OpenRouter-x-MongoDB-3b52fd57c4dc80a4bf07ed6ab238aa2b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fireworks — $50 credits, code MONGODB813 (deadline 10/1): https://docs.fireworks.ai/
# Fireworks is the primary intelligence layer. See FIREWORKS.md.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# --- Fireworks model roster (all optional) -----------------------------------
# The serverless catalogue rotates, so any of these can be repointed without a
# code change. Check the current roster with:
#   python scripts/fireworks_smoke.py --models
# FIREWORKS_MODEL_SCIENTIST=accounts/fireworks/models/kimi-k2-instruct-0905
# FIREWORKS_MODEL_CRITIC=accounts/fireworks/models/deepseek-v3p1
# FIREWORKS_MODEL_REASONER=accounts/fireworks/models/kimi-k2-thinking
# FIREWORKS_MODEL_FAST=accounts/fireworks/models/llama-v3p3-70b-instruct
# FIREWORKS_MODEL_VISION=accounts/fireworks/models/qwen3-vl-235b-a22b-instruct
# FIREWORKS_MODEL_VISION_SMALL=accounts/fireworks/models/qwen2p5-vl-32b-instruct
# FIREWORKS_MODEL_EMBEDDING=accounts/fireworks/models/qwen3-embedding-8b
# FIREWORKS_MODEL_RERANK=accounts/fireworks/models/qwen3-reranker-8b

# --- Fireworks behaviour (all optional) --------------------------------------
# FIREWORKS_TEMPERATURE=0.2            # scientist default; tool calls use 0.1
# FIREWORKS_CRITIC_TEMPERATURE=0.0     # the critic is a judge, not an author
# FIREWORKS_MAX_TOKENS=2048
# FIREWORKS_TIMEOUT=120
# FIREWORKS_MAX_RETRIES=4
# FIREWORKS_STRUCTURED_MAX_ATTEMPTS=3  # schema-repair rounds before failing
# FIREWORKS_EMBEDDING_DIMENSIONS=1024  # MUST match Atlas index numDimensions
# FIREWORKS_EMBEDDING_BATCH_SIZE=64
# FIREWORKS_REASONING_EFFORT=          # low | medium | high | max | none
# FIREWORKS_PERF_METRICS=false         # include server-side timings in responses
# FIREWORKS_PROMPT_CACHE_ISOLATION_KEY=  # set per run to stop cache bleed
# FIREWORKS_PRICE_TABLE=               # path to {"model": {"input":.., "output":..}}
# FIREWORKS_LOG_REQUESTS=false

# LangChain / LangSmith — $50 credits: https://app.notion.com/p/Hackathon-Resources-from-LangChain-34f808527b1780c8a82bd0b8f0c322a2
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=persistent-context-sprint

# ElevenLabs — claim via Discord coupon bot: https://discord.com/invite/VnBvbbcdEC
ELEVENLABS_API_KEY=
