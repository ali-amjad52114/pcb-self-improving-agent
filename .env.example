# Atlas Hackathon Sandbox URI (from the email MongoDB sent you)
# Your build must live in this sandbox to be eligible for finalists.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=persistent_context

# Voyage AI — embeddings for Atlas Vector Search
VOYAGE_API_KEY=
VOYAGEAI_API_KEY=

# OpenRouter — $10 credits: https://app.notion.com/p/openrouter/OpenRouter-x-MongoDB-3b52fd57c4dc80a4bf07ed6ab238aa2b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fireworks — $50 credits, code MONGODB813 (deadline 10/1): https://docs.fireworks.ai/
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# LangChain / LangSmith — $50 credits: https://app.notion.com/p/Hackathon-Resources-from-LangChain-34f808527b1780c8a82bd0b8f0c322a2
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=persistent-context-sprint

# ElevenLabs — claim via Discord coupon bot: https://discord.com/invite/VnBvbbcdEC
ELEVENLABS_API_KEY=
